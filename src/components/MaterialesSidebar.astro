---
import { getAllMateriales } from "../data/materiales";

interface Props {
    currentSlug?: string;
}

const { currentSlug } = Astro.props;

// Orden definido manualmente según el patrón del profesor
const ORDEN = [
    "sae-1010",
    "sae-1020",
    "sae-1045",
    "sae-1060",
    "sae-1075",
    "aisi-4140",
    "aisi-01",
    "aisi-316l",
    "aisi-420",
];

const listaMateriales = getAllMateriales()
    .map(({ id, nombre, slug }) => ({
        id,
        nombre,
        slug,
    }))
    .sort((a, b) => {
        const ia = ORDEN.indexOf(a.slug);
        const ib = ORDEN.indexOf(b.slug);
        // Si un slug no está en ORDEN, lo manda al final
        return (ia === -1 ? 999 : ia) - (ib === -1 ? 999 : ib);
    });
---

<aside class="w-full lg:w-64 shrink-0 space-y-4">
    <!-- Encabezado -->
    <div class="flex items-center justify-between pb-2 border-b border-brand-border">
        <h2 class="text-sm font-bold text-brand-dark uppercase tracking-wider">
            Aceros y Muestras
        </h2>
        <span class="text-xs font-mono font-semibold px-2 py-0.5 bg-slate-200/70 text-brand-dark rounded-full">
            {listaMateriales.length}
        </span>
    </div>

    <!-- Lista de Materiales -->
    <nav class="space-y-0.5 max-h-[calc(100vh-220px)] overflow-y-auto pr-1">
        {listaMateriales.map((item) => {
            const isSelected = item.slug === currentSlug;
            return (
                <a
                    href={`/materiales/${item.slug}`}
                    class={`flex items-center gap-3 px-3 py-2 rounded-lg text-sm transition-all group ${
                        isSelected
                            ? "bg-brand-primary text-white font-semibold shadow-xs"
                            : "text-brand-dark hover:bg-slate-200/60 hover:text-brand-dark"
                    }`}
                >
                    <span class="truncate">{item.nombre}</span>
                </a>
            );
        })}
    </nav>
</aside>
