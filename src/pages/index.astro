---
import Layout from "../layouts/Layout.astro";
import { getAllMateriales } from "../data/materiales";

// Obtenemos todos los materiales y tomamos los primeros 3 como destacados
const materialesDestacados = getAllMateriales().slice(0, 3);
---

<Layout title="Muestrario Metalográfico Digital — UNET">
    <div class="space-y-16 sm:space-y-24 py-4">
        <!-- Hero Principal -->
        <section class="space-y-6">
            <div class="space-y-3 w-full">
                <span class="text-xs font-mono font-bold text-brand-primary uppercase tracking-wider">
                    Laboratorio L051 — UNET
                </span>
                <h1 class="text-2xl sm:text-3xl font-extrabold text-brand-dark tracking-tight">
                    Muestrario Metalográfico Digital
                </h1>

                <div class="pt-2">
                    <button
                        type="button"
                        id="btn-descargar-qr-home"
                        data-material-nombre="Muestrario-Metalografico-UNET"
                        class="inline-flex items-center gap-1.5 px-3 py-2 bg-slate-100 hover:bg-slate-200 text-brand-dark border border-brand-border text-xs font-semibold rounded-lg transition-colors cursor-pointer"
                    >
                        <svg
                            class="w-4 h-4 text-brand-body"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M12 12h4.01M16 20h4M4 12h4m12 0h.01M5 8h2a1 1 0 001-1V5a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1zm12 0h2a1 1 0 001-1V5a1 1 0 00-1-1h-2a1 1 0 00-1 1v2a1 1 0 001 1zM5 20h2a1 1 0 001-1v-2a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1z"
                            ></path>
                        </svg>
                        <span>Descargar QR</span>
                    </button>
                </div>

                <p class="text-lg sm:text-xl text-brand-dark leading-relaxed font-normal">
                    Explora el catálogo técnico de aceros del Laboratorio de
                    Materiales. Escanea, analiza sus propiedades estructurales y
                    conoce sus aplicaciones en la ingeniería.
                </p>
            </div>

            <!-- Banner de Presentación -->
            <div class="relative w-full h-64 sm:h-96 rounded-2xl overflow-hidden border border-brand-border bg-slate-900 group">
                <img
                    src="https://images.unsplash.com/photo-1616996691748-3f5f78093ab0?q=80&w=1032"
                    alt="Laboratorio de Materiales UNET"
                    class="w-full h-full object-cover opacity-80 group-hover:scale-105 transition-transform duration-500"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent flex items-end p-6 sm:p-10">
                    <a
                        href="/materiales"
                        class="inline-flex items-center gap-2 px-5 py-3 bg-brand-primary hover:bg-brand-primary-hover text-white text-sm font-semibold rounded-lg shadow-xs transition-colors"
                    >
                        <span>Explorar Catálogo Completo</span>
                        <svg
                            class="w-4 h-4"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M14 5l7 7m0 0l-7 7m7-7H3"
                            ></path>
                        </svg>
                    </a>
                </div>
            </div>
        </section>

        <!-- Explora los Materiales -->
        <section class="space-y-6">
            <div class="flex items-center justify-between pb-3 border-b border-brand-border">
                <h2 class="text-2xl font-bold text-brand-dark tracking-tight">
                    Materiales Destacados
                </h2>
                <a
                    href="/materiales"
                    class="text-xs font-semibold text-brand-primary hover:underline flex items-center gap-1"
                >
                    <span>Ver todos</span>
                    <span>&rarr;</span>
                </a>
            </div>

            <!-- Grid Responsiva de Tarjetas -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
                {materialesDestacados.map((item) => {
                    const imagenPrincipal =
                        item.imagenes[0] || "/materiales/material-default.jpg";

                    return (
                        <a
                            href={`/materiales/${item.slug}`}
                            class="group bg-white rounded-xl border border-brand-border overflow-hidden hover:border-brand-primary/50 hover:shadow-md transition-all flex flex-col"
                        >
                            <!-- Fotografía -->
                            <div class="h-44 w-full bg-slate-100 overflow-hidden">
                                <img
                                    src={imagenPrincipal}
                                    alt={item.nombre}
                                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                                />
                            </div>

                            <div class="p-5 flex-grow flex flex-col justify-between space-y-4">
                                <div class="flex items-center justify-between gap-3">
                                    <div class="space-y-1">
                                        <h3 class="text-lg font-bold text-brand-dark group-hover:text-brand-primary transition-colors">
                                            {item.nombre}
                                        </h3>
                                        <p class="text-xs text-brand-muted font-mono font-medium">
                                            AISI/SAE {item.norma_aisi_sae} • ISO{" "}
                                            {item.clasificacion_iso}
                                        </p>
                                    </div>

                                    <span
                                        class="w-8 h-8 rounded-full border border-black/20 shrink-0 inline-block shadow-xs"
                                        style={`background-color: ${item.color_identificacion || "#cccccc"};`}
                                        title={`Color comercial: ${item.codigo_color_ferrum || "N/A"}`}
                                    />
                                </div>

                                <div class="pt-3 border-t border-brand-border flex items-center justify-between text-xs text-brand-body font-medium">
                                    <span>
                                        Dureza:{" "}
                                        {item.dureza_max_recocido_hb || "N/A"}
                                    </span>
                                    <span class="text-brand-primary group-hover:translate-x-1 transition-transform">
                                        Ver Ficha &rarr;
                                    </span>
                                </div>
                            </div>
                        </a>
                    );
                })}
            </div>
        </section>

        <!-- Pilares de la Plataforma -->
        <section class="space-y-8">
            <div class="text-center max-w-xl mx-auto space-y-2">
                <h2 class="text-2xl sm:text-3xl font-bold text-brand-dark tracking-tight">
                    ¿Qué te ofrece esta plataforma?
                </h2>
                <p class="text-sm text-brand-body">
                    Herramientas diseñadas para potenciar las prácticas de
                    ingeniería en aula y laboratorio.
                </p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <!-- Pillar 1 -->
                <div class="bg-white rounded-xl border border-brand-border p-6 space-y-4 flex flex-col justify-between">
                    <div class="space-y-3">
                        <div class="w-10 h-10 rounded-lg bg-slate-100 flex items-center justify-center text-brand-primary">
                            <svg
                                class="w-5 h-5"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke="currentColor"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
                                ></path>
                            </svg>
                        </div>
                        <h3 class="text-base font-bold text-brand-dark">
                            Especificaciones Técnicas
                        </h3>
                        <p class="text-xs text-brand-body leading-relaxed">
                            Información detallada de cada acero según las
                            normativas AISI y DIN, incluyendo su composición
                            química, dureza y estados de entrega.
                        </p>
                    </div>
                    <a
                        href="/materiales"
                        class="text-xs font-semibold text-brand-primary hover:underline"
                    >
                        Explorar fichas &rarr;
                    </a>
                </div>

                <!-- Pillar 2 -->
                <div class="bg-white rounded-xl border border-brand-border p-6 space-y-4 flex flex-col justify-between">
                    <div class="space-y-3">
                        <div class="w-10 h-10 rounded-lg bg-slate-100 flex items-center justify-center text-brand-primary">
                            <svg
                                class="w-5 h-5"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke="currentColor"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"
                                ></path>
                            </svg>
                        </div>
                        <h3 class="text-base font-bold text-brand-dark">
                            Recursos Multimedia
                        </h3>
                        <p class="text-xs text-brand-body leading-relaxed">
                            Accede a vídeos explicativos y recursos prácticos
                            asociados a los ensayos de cada probeta del
                            muestrario.
                        </p>
                    </div>
                    <a
                        href="/videos"
                        class="text-xs font-semibold text-brand-primary hover:underline"
                    >
                        Ver contenido &rarr;
                    </a>
                </div>

                <!-- Pillar 3 -->
                <div class="bg-white rounded-xl border border-brand-border p-6 space-y-4 flex flex-col justify-between">
                    <div class="space-y-3">
                        <div class="w-10 h-10 rounded-lg bg-slate-100 flex items-center justify-center text-brand-primary">
                            <svg
                                class="w-5 h-5"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke="currentColor"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"
                                ></path>
                            </svg>
                        </div>
                        <h3 class="text-base font-bold text-brand-dark">
                            Consulta Offline
                        </h3>
                        <p class="text-xs text-brand-body leading-relaxed">
                            Guarda todo el contenido técnico directamente en tu
                            dispositivo. Asegura tu material de estudio sin
                            depender de la red.
                        </p>
                    </div>
                    <a
                        href="/materiales"
                        class="text-xs font-semibold text-brand-primary hover:underline"
                    >
                        Descargar catálogo &rarr;
                    </a>
                </div>
            </div>
        </section>

        <!-- Sobre el Laboratorio UNET -->
        <section class="bg-white rounded-xl border border-brand-border overflow-hidden">
            <div class="grid grid-cols-1 lg:grid-cols-12 items-center">
                <div class="p-8 sm:p-10 lg:col-span-6 space-y-4">
                    <span class="text-xs font-mono font-bold text-brand-primary uppercase tracking-wider">
                        Sótano Edificio C
                    </span>
                    <h2 class="text-2xl sm:text-3xl font-bold text-brand-dark tracking-tight">
                        Laboratorio de Materiales
                    </h2>
                    <p class="text-sm text-brand-body leading-relaxed">
                        Ubicado en el Sótano del Edificio C, este es el núcleo
                        donde se resguardan las probetas y muestras físicas.
                        Esta plataforma digital actúa como una extensión de
                        nuestro laboratorio, permitiendo que el conocimiento
                        técnico trascienda las paredes de la universidad.
                    </p>
                </div>

                <div class="lg:col-span-6 h-64 lg:h-full min-h-[250px] bg-slate-100 relative">
                    <img
                        src="https://www.eduopinions.com/wp-content/uploads/2017/08/Universidad-del-T%C3%A1chira-campus-610x308.jpg"
                        alt="Muestras del Laboratorio UNET"
                        class="w-full h-full object-cover"
                    />
                </div>
            </div>
        </section>
    </div>
</Layout>

<script>
    const btnDescargarHome = document.getElementById("btn-descargar-qr-home");

    btnDescargarHome?.addEventListener("click", async () => {
        const QRCode = (await import("qrcode")).default;

        // ⚠️ Si quieres que el QR apunte a /materiales en vez del home, cambia esto:
        // const currentUrl = `${window.location.origin}/materiales`;
        const currentUrl = window.location.href;

        const nombreMaterial =
            btnDescargarHome.getAttribute("data-material-nombre") || "QR";

        try {
            const qrDataUrl = await QRCode.toDataURL(currentUrl, {
                width: 1000,
                margin: 2,
                color: {
                    dark: "#000000",
                    light: "#ffffff",
                },
            });

            const link = document.createElement("a");
            link.href = qrDataUrl;
            link.download = `QR-${nombreMaterial.replace(/\s+/g, "-")}.png`;
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        } catch (error) {
            console.error("Error generando el código QR:", error);
        }
    });
</script>
