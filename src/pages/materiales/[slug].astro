---
import Layout from "../../layouts/Layout.astro";
import MaterialesSidebar from "../../components/MaterialesSidebar.astro";
import {
    getMaterialBySlug,
    formatearNombreArchivo,
} from "../../data/materiales";

const { slug } = Astro.params;
if (!slug) return Astro.redirect("/404");

const material = getMaterialBySlug(slug);
if (!material) return Astro.redirect("/404");

const propiedadesTecnicas = [
    { etiqueta: "Tipo de material", valor: material.tipo_material || "N/A" },
    {
        etiqueta: "Composición química",
        valor: material.composicion_quimica || "N/A",
    },
    {
        etiqueta: "Dureza máxima en recocido (HB)",
        valor: material.dureza_max_recocido_hb || "N/A",
    },
    {
        etiqueta: "Código de color comercial (Ferrum)",
        valor: material.codigo_color_ferrum || "N/A",
    },
];

const presentacionesTexto = material.presentaciones?.length
    ? material.presentaciones
          .map((p) => {
              const partes = [];
              if (p.codigo_laboratorio)
                  partes.push(`Código: ${p.codigo_laboratorio}`);
              if (p.diametro_pulgadas)
                  partes.push(`Diámetro: ${p.diametro_pulgadas}"`);
              return partes.join(" - ");
          })
          .join(" | ")
    : "N/A";

const aplicaciones = material.imagenes_aplicaciones.map((img) => ({
    src: img,
    nombre: formatearNombreArchivo(img.split("/").pop() || ""),
}));

const esquemasTT = material.imagenes_tt.map((img) => ({
    src: img,
    nombre: formatearNombreArchivo(img.split("/").pop() || ""),
}));

const aumentos = Object.keys(material.microscopia)
    .map((k) => parseInt(k, 10))
    .filter((n) => !isNaN(n))
    .sort((a, b) => a - b);

const microscopiaItems = aumentos.map((n) => ({
    aumento: n,
    src: material.microscopia[String(n)],
}));

const imagenInicial =
    microscopiaItems.length > 0
        ? microscopiaItems[0].src
        : "/materiales/material-default.jpg";
---

<Layout title={material.nombre}>
    <div class="flex flex-col lg:flex-row gap-8 items-start py-4">
        <MaterialesSidebar currentSlug={material.slug || slug} />

        <article class="flex-grow max-w-4xl w-full bg-white rounded-xl border border-brand-border shadow-xs overflow-hidden p-6 sm:p-8 space-y-10">
            <!-- Bloque 1: info + visor de microscopía -->
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
                <div class="lg:col-span-7 space-y-6">
                    <div class="flex items-start justify-between gap-3 flex-wrap">
                        <h1 class="text-3xl sm:text-4xl font-extrabold text-brand-dark tracking-tight">
                            {material.nombre}
                        </h1>
                        <button
                            type="button"
                            id="btn-descargar-qr"
                            data-material-nombre={material.nombre}
                            title="Descargar QR"
                            class="text-brand-primary hover:text-brand-primary-hover transition-colors cursor-pointer mt-1"
                            aria-label="Descargar QR"
                        >
                            <svg
                                class="w-5 h-5"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke="currentColor"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M12 12h4.01M16 20h4M4 12h4m12 0h.01M5 8h2a1 1 0 001-1V5a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1zm12 0h2a1 1 0 001-1V5a1 1 0 00-1-1h-2a1 1 0 00-1 1v2a1 1 0 001 1zM5 20h2a1 1 0 001-1v-2a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1z"
                                ></path>
                            </svg>
                        </button>
                    </div>

                    <div class="space-y-4 text-sm text-brand-body leading-relaxed">
                        <div>
                            <strong class="block text-brand-dark font-bold text-base mb-1">
                                Composición Química:
                            </strong>
                            <p>{material.composicion_quimica || "N/A"}</p>
                        </div>
                        <div>
                            <strong class="block text-brand-dark font-bold text-base mb-1">
                                Dureza máxima en recocido:
                            </strong>
                            <p>{material.dureza_max_recocido_hb || "N/A"}</p>
                        </div>
                        <div>
                            <strong class="block text-brand-dark font-bold text-base mb-1">
                                Aplicaciones:
                            </strong>
                            <p>{material.aplicaciones || "N/A"}</p>
                        </div>
                    </div>
                </div>

                <div class="lg:col-span-5 space-y-3">
                    <div class="w-full h-72 sm:h-80 rounded-lg overflow-hidden border border-brand-border bg-slate-100">
                        <img
                            id="visor-microscopia"
                            src={imagenInicial}
                            alt={`Microscopía de ${material.nombre}`}
                            class="w-full h-full object-cover"
                        />
                    </div>

                    {microscopiaItems.length > 0 && (
                        <div
                            class="flex flex-wrap gap-2"
                            id="botones-microscopia"
                        >
                            {microscopiaItems.map((item, i) => (
                                <button
                                    type="button"
                                    class:list={[
                                        "micro-btn px-3 py-1.5 rounded-lg text-xs font-semibold border transition-colors cursor-pointer",
                                        i === 0
                                            ? "bg-brand-primary text-white border-brand-primary"
                                            : "bg-white text-brand-dark border-brand-border hover:bg-slate-50",
                                    ]}
                                    data-aumento={item.aumento}
                                    data-src={item.src}
                                >
                                    {item.aumento}x
                                </button>
                            ))}
                        </div>
                    )}
                </div>
            </div>

            <!-- Bloque 2: Tabla de propiedades -->
            <div class="divide-y divide-brand-border border-t border-b border-brand-border">
                {propiedadesTecnicas.map((prop) => (
                    <div class="py-3.5 flex flex-col sm:flex-row sm:items-center justify-between gap-1 sm:gap-4 text-sm">
                        <span class="text-brand-body text-xs sm:text-sm font-medium sm:w-1/2">
                            {prop.etiqueta}
                        </span>
                        <span class="text-brand-dark font-bold text-xs sm:text-sm sm:w-1/2 sm:text-left">
                            {prop.valor}
                        </span>
                    </div>
                ))}
                <div class="py-3.5 flex flex-col sm:flex-row sm:items-center justify-between gap-1 sm:gap-4 text-sm">
                    <span class="text-brand-body text-xs sm:text-sm font-medium sm:w-1/2">
                        Presentaciones Disponibles (Lab / Diámetro)
                    </span>
                    <span class="text-brand-dark font-bold text-xs sm:text-sm sm:w-1/2 sm:text-left">
                        {presentacionesTexto}
                    </span>
                </div>

                {material.procesos_tratamiento.length > 0 && (
                    <>
                        <div class="pt-6 pb-2">
                            <h3 class="text-lg font-bold text-brand-dark">
                                Tratamiento Térmico
                            </h3>
                        </div>
                        {material.procesos_tratamiento.map((p) => (
                            <div class="py-3.5 flex flex-col sm:flex-row sm:items-center justify-between gap-1 sm:gap-4 text-sm">
                                <span class="text-brand-body text-xs sm:text-sm font-medium sm:w-1/2">
                                    {p.etiqueta}
                                </span>
                                <span class="text-brand-dark font-bold text-xs sm:text-sm sm:w-1/2 sm:text-left">
                                    {p.valor}
                                </span>
                            </div>
                        ))}
                        {material.tratamiento_termico?.notas && (
                            <div class="py-3.5">
                                <p class="text-xs text-brand-muted italic">
                                    Nota: {material.tratamiento_termico.notas}
                                </p>
                            </div>
                        )}
                    </>
                )}
            </div>

            <!-- Bloque 3: Esquemas de Tratamiento Térmico -->
            {esquemasTT.length > 0 && (
                <div class="space-y-3 pt-2">
                    <h3 class="text-lg font-bold text-brand-dark">
                        Esquemas de Tratamiento Térmico
                    </h3>
                    <div
                        class:list={[
                            "grid gap-4",
                            esquemasTT.length === 2
                                ? "grid-cols-1 sm:grid-cols-2"
                                : "grid-cols-1",
                        ]}
                    >
                        {esquemasTT.map((esq) => (
                            <div class="space-y-2">
                                <div class="w-full rounded-lg overflow-hidden border border-brand-border bg-white">
                                    <img
                                        src={esq.src}
                                        alt={esq.nombre}
                                        class="w-full h-auto object-contain"
                                    />
                                </div>
                                <p class="text-xs text-brand-muted text-center">
                                    {esq.nombre}
                                </p>
                            </div>
                        ))}
                    </div>
                </div>
            )}

            <!-- Bloque 4: Carousel de Aplicaciones (al final) -->
            {aplicaciones.length > 0 && (
                <div class="space-y-3" id="carousel-aplicaciones">
                    <div class="relative w-full h-80 sm:h-96 rounded-lg overflow-hidden border border-brand-border bg-slate-100">
                        {aplicaciones.map((app, i) => (
                            <div
                                class:list={[
                                    "absolute inset-0 transition-opacity duration-300 p-2",
                                    i === 0
                                        ? "opacity-100"
                                        : "opacity-0 pointer-events-none",
                                ]}
                                data-slide={i}
                            >
                                <img
                                    src={app.src}
                                    alt={app.nombre}
                                    class="w-full h-full object-contain drop-shadow-sm"
                                />
                                <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-brand-dark/90 to-transparent p-2 pt-8">
                                    <span class="block text-center text-white text-base sm:text-lg font-bold drop-shadow-[0_2px_2px_rgba(0,0,0,0.8)]">
                                        {app.nombre}
                                    </span>
                                </div>
                            </div>
                        ))}
                        {aplicaciones.length > 1 && (
                            <>
                                <button
                                    type="button"
                                    class="carousel-prev absolute left-3 top-1/2 -translate-y-1/2 w-9 h-9 rounded-full bg-brand-primary hover:bg-brand-primary-hover text-white border-2 border-white shadow-md flex items-center justify-center cursor-pointer transition-transform hover:scale-110 z-10"
                                    aria-label="Anterior"
                                >
                                    <span class="text-xl font-bold leading-none pb-0.5">
                                        ‹
                                    </span>
                                </button>
                                <button
                                    type="button"
                                    class="carousel-next absolute right-3 top-1/2 -translate-y-1/2 w-9 h-9 rounded-full bg-brand-primary hover:bg-brand-primary-hover text-white border-2 border-white shadow-md flex items-center justify-center cursor-pointer transition-transform hover:scale-110 z-10"
                                    aria-label="Siguiente"
                                >
                                    <span class="text-xl font-bold leading-none pb-0.5">
                                        ›
                                    </span>
                                </button>
                            </>
                        )}
                    </div>
                    {aplicaciones.length > 1 && (
                        <div class="flex justify-center gap-1.5">
                            {aplicaciones.map((_, i) => (
                                <button
                                    type="button"
                                    class:list={[
                                        "carousel-dot w-2 h-2 rounded-full transition-colors cursor-pointer",
                                        i === 0
                                            ? "bg-brand-primary"
                                            : "bg-slate-300",
                                    ]}
                                    data-dot={i}
                                    aria-label={`Ir a slide ${i + 1}`}
                                ></button>
                            ))}
                        </div>
                    )}
                </div>
            )}
        </article>
    </div>
</Layout>

<script>
    // QR
    const btnDescargar = document.getElementById("btn-descargar-qr");
    btnDescargar?.addEventListener("click", async () => {
        const QRCode = (await import("qrcode")).default;
        const currentUrl = window.location.href;
        const nombreMaterial =
            btnDescargar.getAttribute("data-material-nombre") || "material";
        try {
            const qrDataUrl = await QRCode.toDataURL(currentUrl, {
                width: 1000,
                margin: 2,
                color: { dark: "#000000", light: "#ffffff" },
            });
            const link = document.createElement("a");
            link.href = qrDataUrl;
            link.download = `QR-${nombreMaterial.replace(/\s+/g, "-")}.png`;
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        } catch (error) {
            console.error("Error generando el código QR:", error);
        }
    });

    // Visor de microscopía
    const visor = document.getElementById(
        "visor-microscopia",
    ) as HTMLImageElement | null;
    const botonesMicro = document.querySelectorAll("[data-aumento]");
    if (visor && botonesMicro.length > 0) {
        botonesMicro.forEach((btn) => {
            btn.addEventListener("click", () => {
                const el = btn as HTMLElement;
                const nuevoSrc = el.getAttribute("data-src");
                if (nuevoSrc) visor.src = nuevoSrc;
                botonesMicro.forEach((b) => {
                    const bEl = b as HTMLElement;
                    const active = bEl === el;
                    bEl.classList.toggle("bg-brand-primary", active);
                    bEl.classList.toggle("text-white", active);
                    bEl.classList.toggle("border-brand-primary", active);
                    bEl.classList.toggle("bg-white", !active);
                    bEl.classList.toggle("text-brand-dark", !active);
                    bEl.classList.toggle("border-brand-border", !active);
                });
            });
        });
    }

    // Carousel de aplicaciones
    const carousel = document.getElementById("carousel-aplicaciones");
    if (carousel) {
        const slides = carousel.querySelectorAll("[data-slide]");
        const dots = carousel.querySelectorAll("[data-dot]");
        const prev = carousel.querySelector(".carousel-prev");
        const next = carousel.querySelector(".carousel-next");
        let current = 0;
        const goTo = (index: number) => {
            slides.forEach((s, i) => {
                (s as HTMLElement).classList.toggle("opacity-100", i === index);
                (s as HTMLElement).classList.toggle("opacity-0", i !== index);
                (s as HTMLElement).classList.toggle(
                    "pointer-events-none",
                    i !== index,
                );
            });
            dots.forEach((d, i) => {
                (d as HTMLElement).classList.toggle(
                    "bg-brand-primary",
                    i === index,
                );
                (d as HTMLElement).classList.toggle(
                    "bg-slate-300",
                    i !== index,
                );
            });
            current = index;
        };
        prev?.addEventListener("click", () =>
            goTo((current - 1 + slides.length) % slides.length),
        );
        next?.addEventListener("click", () =>
            goTo((current + 1) % slides.length),
        );
        dots.forEach((dot, i) => dot.addEventListener("click", () => goTo(i)));
    }
</script>
