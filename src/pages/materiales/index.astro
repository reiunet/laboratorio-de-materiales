---
import Layout from "../../layouts/Layout.astro";
import MaterialesSidebar from "../../components/MaterialesSidebar.astro";
---

<Layout title="Catálogo de Materiales">
    <div class="flex flex-col lg:flex-row gap-8 items-start py-4">
        <!-- Sidebar Izquierdo Persistente (Estilo Plano) -->
        <MaterialesSidebar />

        <!-- Body Principal: Texto Informativo + Galería -->
        <section class="flex-grow space-y-8 max-w-4xl">
            <!-- Contenido Textual Editorial -->
            <div class="space-y-4 text-brand-dark">
                <span
                    class="text-xs font-mono font-bold text-brand-primary uppercase tracking-wider"
                >
                    Laboratorio L051 — UNET
                </span>

                <h1
                    class="text-3xl font-extrabold tracking-tight text-brand-dark sm:text-4xl"
                >
                    Muestrario Metalográfico Digital
                </h1>

                <div
                    class="space-y-4 text-sm leading-relaxed text-brand-body pt-2"
                >
                    <p>
                        Este catálogo digital nace como una iniciativa del
                        Servicio Comunitario para modernizar el acceso al
                        muestrario físico del Laboratorio de Materiales UNET.
                        Nuestro objetivo es centralizar las fichas técnicas,
                        micrografías y ensayos analizados en las aulas de
                        ingeniería, permitiendo una consulta rápida que
                        complemente las prácticas de laboratorio tradicionales.
                    </p>

                    <p>
                        Para iniciar, utiliza el panel izquierdo de navegación,
                        donde podrás buscar materiales por su denominación
                        comercial o filtrar el catálogo según su categoría
                        técnica y normas equivalentes (AISI/DIN). Al seleccionar
                        un acero, esta pantalla se actualizará automáticamente
                        mostrando su composición química, aplicaciones
                        estructurales y contenido multimedia asociado.
                    </p>

                    <p>
                        Pensando en las limitaciones de conectividad y energía
                        en el laboratorio, la plataforma permite el acceso y
                        descarga offline. Puedes exportar la ficha del material
                        que estás consultando, seleccionar un grupo específico o
                        descargar el catálogo completo en un formato PDF
                        optimizado para llevar la información técnica
                        directamente en tus dispositivos sin depender de la red.
                    </p>
                </div>
            </div>

            <!-- Muestras Destacadas / Galería de Ejemplo -->
            <div class="pt-4 border-t border-brand-border space-y-3">
                <span
                    class="text-xs font-mono font-bold text-brand-muted uppercase tracking-wider block"
                >
                    Vista Previa del Muestrario Físico
                </span>

                <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                    <div
                        class="group overflow-hidden rounded-lg border border-brand-border bg-slate-100"
                    >
                        <img
                            src="https://images.unsplash.com/photo-1535813547-99c456a41d4a?auto=format&fit=crop&w=600&q=80"
                            alt="Probeta de Acero"
                            class="w-full h-36 object-cover group-hover:scale-105 transition-transform duration-300"
                        />
                        <span
                            class="block p-2 text-center text-xs font-mono text-brand-body bg-white border-t border-brand-border"
                        >
                            Probetas de Ensayo
                        </span>
                    </div>

                    <div
                        class="group overflow-hidden rounded-lg border border-brand-border bg-slate-100"
                    >
                        <img
                            src="https://images.unsplash.com/photo-1504917595217-d4dc5ebe6122?auto=format&fit=crop&w=600&q=80"
                            alt="Estructura Metalográfica"
                            class="w-full h-36 object-cover group-hover:scale-105 transition-transform duration-300"
                        />
                        <span
                            class="block p-2 text-center text-xs font-mono text-brand-body bg-white border-t border-brand-border"
                        >
                            Microestructura
                        </span>
                    </div>

                    <div
                        class="group overflow-hidden rounded-lg border border-brand-border bg-slate-100"
                    >
                        <img
                            src="https://images.unsplash.com/photo-1581092335397-9583fe92d232?auto=format&fit=crop&w=600&q=80"
                            alt="Ataque Químico"
                            class="w-full h-36 object-cover group-hover:scale-105 transition-transform duration-300"
                        />
                        <span
                            class="block p-2 text-center text-xs font-mono text-brand-body bg-white border-t border-brand-border"
                        >
                            Análisis Metalográfico
                        </span>
                    </div>
                </div>
            </div>
        </section>
    </div>
</Layout>
