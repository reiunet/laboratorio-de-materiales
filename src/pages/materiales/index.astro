---
import Layout from "../../layouts/Layout.astro";
import MaterialesSidebar from "../../components/MaterialesSidebar.astro";
import laboratorioImagenes from "../../data/laboratorio-imagenes.json";

const imagenesLaboratorio: string[] = laboratorioImagenes as string[];
---

<Layout title="Catálogo de Materiales">
    <div class="flex flex-col lg:flex-row gap-8 items-start py-4">
        <MaterialesSidebar />

        <section class="flex-grow space-y-8 max-w-4xl">
            <!-- Contenido Textual -->
            <div class="space-y-4 text-brand-dark">
                <span class="text-xs font-mono font-bold text-brand-primary uppercase tracking-wider">
                    Laboratorio L051 — UNET
                </span>
                <h1 class="text-3xl font-extrabold tracking-tight text-brand-dark sm:text-4xl">
                    Muestrario Metalográfico Digital
                </h1>
                <div class="space-y-4 leading-relaxed text-brand-body pt-2">
                    <p>
                        Este catálogo digital nace como una iniciativa del
                        Servicio Comunitario para modernizar el acceso al
                        muestrario físico del Laboratorio de Materiales UNET.
                        Nuestro objetivo es centralizar las fichas técnicas,
                        micrografías y ensayos analizados en las aulas de
                        ingeniería, permitiendo una consulta rápida que
                        complemente las prácticas de laboratorio tradicionales.
                    </p>
                    <p>
                        Para iniciar, utiliza el panel izquierdo de navegación,
                        donde podrás buscar materiales por su denominación
                        comercial o filtrar el catálogo según su categoría
                        técnica y normas equivalentes (AISI/SAE). Al seleccionar
                        un acero, esta pantalla se actualizará automáticamente
                        mostrando su composición química, aplicaciones
                        estructurales y contenido multimedia asociado.
                    </p>
                    <p>
                        Pensando en las limitaciones de conectividad y energía
                        en el laboratorio, la plataforma permite el acceso y
                        descarga offline. Puedes exportar la ficha del material
                        que estás consultando, seleccionar un grupo específico o
                        descargar el catálogo completo en un formato PDF
                        optimizado para llevar la información técnica
                        directamente en tus dispositivos sin depender de la red.
                    </p>
                </div>
            </div>

            <!-- Galería del Laboratorio -->
            {imagenesLaboratorio.length > 0 && (
                <div class="pt-4 border-t border-brand-border space-y-3">
                    <span class="text-xs font-mono font-bold text-brand-primary uppercase tracking-wider block">
                        Galería del Laboratorio
                    </span>
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                        {imagenesLaboratorio.map((src, i) => (
                            <button
                                type="button"
                                class="galeria-item group overflow-hidden rounded-lg border border-brand-border bg-slate-100 cursor-pointer"
                                data-galeria-index={i}
                            >
                                <img
                                    src={src}
                                    alt={`Imagen del laboratorio ${i + 1}`}
                                    class="w-full h-44 object-cover group-hover:scale-105 transition-transform duration-300"
                                />
                            </button>
                        ))}
                    </div>
                </div>
            )}
        </section>
    </div>

    <!-- Lightbox -->
    <div
        id="lightbox"
        class="fixed inset-0 z-50 bg-black/90 hidden items-center justify-center p-4"
    >
        <button
            type="button"
            id="lightbox-close"
            class="absolute top-4 right-4 w-10 h-10 rounded-full bg-white/10 hover:bg-white/20 text-white flex items-center justify-center cursor-pointer z-10"
            aria-label="Cerrar"
        >
            <svg
                class="w-6 h-6"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
            >
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M6 18L18 6M6 6l12 12"
                ></path>
            </svg>
        </button>

        <button
            type="button"
            id="lightbox-prev"
            class="absolute left-4 top-1/2 -translate-y-1/2 w-10 h-10 rounded-full bg-white/10 hover:bg-white/20 text-white flex items-center justify-center cursor-pointer z-10"
            aria-label="Anterior"
        >
            <span class="text-2xl font-bold leading-none pb-0.5">‹</span>
        </button>

        <button
            type="button"
            id="lightbox-next"
            class="absolute right-4 top-1/2 -translate-y-1/2 w-10 h-10 rounded-full bg-white/10 hover:bg-white/20 text-white flex items-center justify-center cursor-pointer z-10"
            aria-label="Siguiente"
        >
            <span class="text-2xl font-bold leading-none pb-0.5">›</span>
        </button>

        <img
            id="lightbox-img"
            src=""
            alt=""
            class="max-w-full max-h-full object-contain"
        />
    </div>
</Layout>

<script>
    const imagenes = Array.from(
        document.querySelectorAll<HTMLButtonElement>("[data-galeria-index]"),
    );
    const lightbox = document.getElementById("lightbox") as HTMLElement | null;
    const lightboxImg = document.getElementById(
        "lightbox-img",
    ) as HTMLImageElement | null;
    const btnClose = document.getElementById("lightbox-close");
    const btnPrev = document.getElementById("lightbox-prev");
    const btnNext = document.getElementById("lightbox-next");

    if (lightbox && lightboxImg && imagenes.length > 0) {
        let current = 0;

        const abrir = (index: number) => {
            current = index;
            const img = imagenes[index].querySelector("img");
            if (img) {
                lightboxImg.src = img.src;
                lightboxImg.alt = img.alt;
            }
            lightbox.classList.remove("hidden");
            lightbox.classList.add("flex");
            document.body.style.overflow = "hidden";
        };

        const cerrar = () => {
            lightbox.classList.add("hidden");
            lightbox.classList.remove("flex");
            document.body.style.overflow = "";
        };

        const irA = (index: number) => {
            current = (index + imagenes.length) % imagenes.length;
            const img = imagenes[current].querySelector("img");
            if (img) {
                lightboxImg.src = img.src;
                lightboxImg.alt = img.alt;
            }
        };

        imagenes.forEach((btn, i) => {
            btn.addEventListener("click", () => abrir(i));
        });

        btnClose?.addEventListener("click", cerrar);
        btnPrev?.addEventListener("click", () => irA(current - 1));
        btnNext?.addEventListener("click", () => irA(current + 1));

        lightbox.addEventListener("click", (e) => {
            if (e.target === lightbox) cerrar();
        });

        document.addEventListener("keydown", (e) => {
            if (lightbox.classList.contains("hidden")) return;
            if (e.key === "Escape") cerrar();
            if (e.key === "ArrowLeft") irA(current - 1);
            if (e.key === "ArrowRight") irA(current + 1);
        });
    }
</script>
